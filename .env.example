# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=huellas-al-hogar
PGUSER=postgres
PGPASSWORD=tu_contraseña_de_postgres

# Clave para firmar los tokens.
# Para crear una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Duración del token cuando no se marca "mantener sesión iniciada"
JWT_EXPIRES_IN=8h

# Opcional. Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173